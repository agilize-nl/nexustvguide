<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D2563EB" />
            <stroke android:width="2dp" android:color="#FFFFCC00" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#333B82F6" />
            <stroke android:width="2dp" android:color="#3B82F6" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#171A21" />
            <stroke android:width="1dp" android:color="#263042" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
