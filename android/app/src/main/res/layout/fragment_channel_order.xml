<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channel_order_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/programguide_content_background"
    android:clickable="true"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:descendantFocusability="afterDescendants"
    android:paddingStart="48dp"
    android:paddingTop="32dp"
    android:paddingEnd="48dp"
    android:paddingBottom="24dp">

    <!-- Header with Logo -->
    <ImageView
        android:id="@+id/iv_channel_order_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/app_logo"
        android:contentDescription="@string/app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tv_channel_order_title" />

    <TextView
        android:id="@+id/tv_channel_order_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/channel_order_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:fontFamily="@font/open_sans_bold"
        app:layout_constraintStart_toEndOf="@id/iv_channel_order_logo"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_channel_order_instructions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/channel_order_instructions_normal"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/open_sans_regular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_channel_order_title" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_channel_order"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:descendantFocusability="afterDescendants"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_channel_order_instructions"
        tools:listitem="@layout/item_channel_order" />

    <!-- Loading ProgressBar -->
    <ProgressBar
        android:id="@+id/channel_order_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_channel_order_instructions" />

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/channel_order_error_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_channel_order_instructions">

        <TextView
            android:id="@+id/tv_channel_order_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/channel_order_error_message"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_retry_channel_order"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/channel_order_btn_bg"
            android:text="@string/channel_order_btn_retry"
            android:textColor="@color/text_primary"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_reset_order"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/channel_order_btn_bg"
            android:text="@string/channel_order_btn_reset"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_done"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/channel_order_btn_bg"
            android:text="@string/channel_order_btn_done"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/open_sans_bold"
            android:paddingStart="28dp"
            android:paddingEnd="28dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
