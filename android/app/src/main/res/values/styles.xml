<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NexusTVGuide" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:colorPrimary">@color/accent_blue</item>
        <item name="android:colorPrimaryDark">@color/dark_background</item>
        <item name="android:colorAccent">@color/accent_focused</item>
    </style>

    <!-- Onzichtbare relay voor de NLZIET koude-startretry. Blijft in de voorgrondtaak
         zodat de tweede intent niet door background-activity-launch geblokkeerd wordt. -->
    <style name="Theme.NexusTVGuide.Relay" parent="Theme.NexusTVGuide">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
