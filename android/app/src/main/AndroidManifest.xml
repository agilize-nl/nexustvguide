<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <package android:name="nl.nlziet" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nlziet" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:scheme="https"
                android:host="nlzietshare.page.link" />
        </intent>
    </queries>

    <application
        android:name=".NexusTVGuideApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_nexus_beam"
        android:label="@string/app_name"
        android:banner="@drawable/tv_banner_nexus_beam"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexusTVGuide">

        <activity
            android:name=".ui.MainActivity"
            android:banner="@drawable/tv_banner_nexus_beam"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nexus_beam"
            android:label="@string/app_name"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Onzichtbare relay die de NLZIET koude-start-deeplink betrouwbaar maakt.
             Draait in een eigen task en wordt niet in Recents getoond. -->
        <activity
            android:name=".util.NlzietRelayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@style/Theme.NexusTVGuide.Relay" />

    </application>

</manifest>
